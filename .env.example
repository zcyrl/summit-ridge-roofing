# Server-only Whop credential. Not needed on whop.app, where the platform
# injects a short-lived key for server fetches. Required for plain `npm run dev`
# and for scripts/create-plans.ts.
WHOP_API_KEY=

# The business that owns the plans. Injected on whop.app.
WHOP_ACCOUNT_ID=

# Use https://sandbox-api.whop.com for a sandbox local test.
WHOP_API_ORIGIN=https://api.whop.com

# Pin the Current API shape. Change only when you have read the migration notes.
WHOP_API_VERSION=2026-11-13-1

# Owner-only invoice tool. Generate a long random value for production.
ADMIN_KEY=

# 1 = simulate server-side Whop calls for UI review (no real Elements mount).
# Keep 0 anywhere a buyer can reach.
WHOP_DEMO_MODE=0
